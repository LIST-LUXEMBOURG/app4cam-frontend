{
  "name": "app4cam-frontend",
  "version": "5.7.0-next",
  "productName": "App4Cam",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Daniel Waxweiler",
    "email": "daniel.waxweiler@list.lu"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "quasar prepare",
    "build": "quasar build",
    "check": "vue-tsc --noEmit --skipLibCheck",
    "concurrently:dev:vitest": "concurrently \"quasar dev\" \"vitest\"",
    "dev": "quasar dev",
    "format": "prettier --write --ignore-unknown .",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "prepare": "husky",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "2.0.4",
    "axios": "1.20.0",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "pinia": "4.0.3",
    "quasar": "2.30.1",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pinia/testing": "2.0.1",
    "@quasar/app-vite": "3.8.1",
    "@quasar/vite-plugin": "2.0.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "autoprefixer": "10.5.5",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
