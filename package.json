{
  "name": "app4cam-frontend",
  "version": "5.7.0",
  "productName": "App4Cam",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "quasar prepare",
    "build": "quasar build",
    "check": "vue-tsc --noEmit --skipLibCheck",
    "concurrently:dev:vitest": "concurrently \"quasar dev\" \"vitest\"",
    "dev": "quasar dev",
    "format": "prettier --write --ignore-unknown .",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "prepare": "husky",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "2.0.2",
    "axios": "1.18.1",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "pinia": "3.0.4",
    "quasar": "2.21.1",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@pinia/testing": "1.0.3",
    "@quasar/app-vite": "2.6.2",
    "@quasar/vite-plugin": "1.12.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.1.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.21",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "typescript": "5.9.3",
    "vite-plugin-checker": "0.14.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Daniel Waxweiler",
    "email": "daniel.waxweiler@list.lu"
  }
}
